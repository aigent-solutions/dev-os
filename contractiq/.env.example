# =============================================================================
# ContractIQ — environment variables
# Copy to .env.local for local development and fill in the values.
# In Netlify: Site configuration > Environment variables (set for all deploy contexts).
# Variables without the NEXT_PUBLIC_ prefix are never sent to the browser.
# Validated at boot by src/lib/env.ts (the app refuses to start if a required value is missing).
# =============================================================================

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=                     # Public base URL, no trailing slash. Local: http://localhost:8888 (netlify dev). Prod: https://<your-domain>. Used for auth email redirects (/auth/callback)
NEXT_PUBLIC_SHOW_CALIBRATION_WARNING=    # true | false (default false). Set true when the monthly calibration eval shows ≥ 15% miscalibration (engineering-doc §8.8)

# -----------------------------------------------------------------------------
# Supabase
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=                # Supabase project URL — Dashboard > Project Settings > API > Project URL
NEXT_PUBLIC_SUPABASE_ANON_KEY=           # Supabase anon/public key — Dashboard > Project Settings > API > anon public
# SERVER ONLY
SUPABASE_SERVICE_ROLE_KEY=               # Supabase service role key — Dashboard > Project Settings > API > service_role. Bypasses RLS: never expose to the client, never prefix with NEXT_PUBLIC_

# -----------------------------------------------------------------------------
# OpenAI
# -----------------------------------------------------------------------------
# SERVER ONLY
OPENAI_API_KEY=                          # OpenAI secret key — platform.openai.com > API keys. Use a project key with access to the models below
# SERVER ONLY
OPENAI_EXTRACTION_MODEL=                 # Model for key-term extraction (default gpt-4o). Change to switch models without a code deploy
# SERVER ONLY
OPENAI_CHAT_MODEL=                       # Model for contract chat (default gpt-4o)
# SERVER ONLY
OPENAI_PRICE_INPUT_PER_MTOK=             # USD per 1M input tokens for the models above — platform.openai.com/pricing. Used for ai_usage_logs.cost_usd
# SERVER ONLY
OPENAI_PRICE_OUTPUT_PER_MTOK=            # USD per 1M output tokens for the models above — platform.openai.com/pricing
# SERVER ONLY
OPENAI_USER_HASH_SALT=                   # Random secret (≥ 32 chars, e.g. `openssl rand -hex 32`). Salts sha256(user_id) sent as the OpenAI `user` param so no raw IDs leave the app
# SERVER ONLY
OPENAI_MONTHLY_BUDGET_USD=               # Monthly OpenAI budget in USD (e.g. 400). The daily job logs COST_BUDGET_WARNING at ≥ 80%

# -----------------------------------------------------------------------------
# Prompts / AI behaviour
# -----------------------------------------------------------------------------
# SERVER ONLY
EXTRACTION_PROMPT_VERSION=               # Active extraction prompt module (default extraction-v1.0). Must match a PROMPT_VERSION exported in src/lib/ai/prompts/
# SERVER ONLY
CHAT_PROMPT_VERSION=                     # Active chat prompt module (default chat-v1.0)
# SERVER ONLY
CHAT_MAX_INPUT_TOKENS=                   # Max input tokens per chat call; oldest history trimmed first (default 100000)

# -----------------------------------------------------------------------------
# Contract processing (engineering-doc §6.6)
# -----------------------------------------------------------------------------
# SERVER ONLY
PROCESSING_MODE=                         # background | sync (default background). Set sync when the Netlify plan/site has no Background Functions — extraction then runs inside POST /api/contracts/{id}/process
# SERVER ONLY
PROCESSING_SYNC_FALLBACK=                # true | false (default true). In background mode, run extraction synchronously if dispatching the background function fails (non-202, network error, or > 3 s)
# SERVER ONLY
SYNC_PROCESSING_BUDGET_MS=               # Time budget for sync processing in ms (default 24000). Requires the Netlify function timeout raised to 26 s
# SERVER ONLY
INTERNAL_FUNCTION_SECRET=                # Random secret (≥ 32 chars, e.g. `openssl rand -hex 32`). Sent as x-internal-secret from /process to the background function

# -----------------------------------------------------------------------------
# Testing (local / CI only — not needed in Netlify production)
# -----------------------------------------------------------------------------
PLAYWRIGHT_BASE_URL=                     # Base URL for E2E tests (default http://localhost:8888)
EVAL_USE_LIVE_OPENAI=                    # true | false (default false). true runs evals/ against the real OpenAI API instead of recorded fixtures
OPENAI_BASE_URL=                         # Leave empty in production. CI/E2E only: http://localhost:4010/v1 points the OpenAI SDK at the local mock server (tests/mocks/openai-mock-server.ts)

# -----------------------------------------------------------------------------
# Developer tooling (local only)
# -----------------------------------------------------------------------------
SUPABASE_PROJECT_REF=                    # Supabase project ref (the <ref> in https://<ref>.supabase.co) — used by `npm run db:types:remote` to generate src/types/database.types.ts

# -----------------------------------------------------------------------------
# Set automatically by Netlify — do NOT set these yourself
# -----------------------------------------------------------------------------
# URL                 Site's main URL; /process uses it to reach /.netlify/functions/process-contract-background (falls back to NEXT_PUBLIC_APP_URL locally)
# DEPLOY_PRIME_URL    Deploy-preview / branch URL
# COMMIT_REF          Git SHA, returned as `version` by GET /api/health
# CONTEXT             production | deploy-preview | branch-deploy | dev
