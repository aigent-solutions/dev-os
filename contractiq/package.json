{
  "name": "contractiq",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "netlify dev",
    "dev:next": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint && node scripts/check-no-hex.mjs && node scripts/check-admin-imports.mjs",
    "check:pdf-worker": "node scripts/check-pdf-worker-traced.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:unit": "vitest run --project unit --coverage --coverage.provider=v8 --coverage.include=src/lib/** --coverage.thresholds.lines=85",
    "test:integration": "vitest run --project integration --coverage --coverage.provider=v8 --coverage.include=src/server/** --coverage.thresholds.lines=85",
    "test:e2e": "playwright test",
    "test:e2e:local": "bash scripts/e2e-local.sh npx playwright test --project=chromium",
    "demo:record": "bash scripts/e2e-local.sh npx tsx scripts/record-demo.ts",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local --schema public > src/types/database.types.ts",
    "db:types:remote": "supabase gen types typescript --project-id \"$SUPABASE_PROJECT_REF\" --schema public > src/types/database.types.ts",
    "db:verify-rls": "bash scripts/verify-rls.sh",
    "eval:extraction": "NODE_OPTIONS=--conditions=react-server tsx evals/run-extraction-eval.ts",
    "eval:calibration": "NODE_OPTIONS=--conditions=react-server tsx evals/run-calibration-eval.ts",
    "eval:chat": "NODE_OPTIONS=--conditions=react-server tsx evals/run-chat-groundedness.ts",
    "postinstall": "node scripts/copy-pdf-worker.mjs",
    "prebuild": "node scripts/copy-pdf-worker.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@netlify/functions": "^2.8.2",
    "@radix-ui/react-collapsible": "^1.1.21",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-dropdown-menu": "^2.1.25",
    "@radix-ui/react-label": "^2.1.16",
    "@radix-ui/react-popover": "^1.2.0",
    "@radix-ui/react-progress": "^1.1.17",
    "@radix-ui/react-select": "^2.3.8",
    "@radix-ui/react-slot": "^1.4.0",
    "@radix-ui/react-tabs": "^1.1.22",
    "@radix-ui/react-toast": "^1.2.24",
    "@radix-ui/react-tooltip": "^1.3.0",
    "@radix-ui/react-visually-hidden": "^1.2.12",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "@tanstack/react-query": "^5.104.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "js-tiktoken": "^1.0.21",
    "lucide-react": "^0.446.0",
    "nanoid": "^5.1.16",
    "next": "^14.2.35",
    "openai": "^4.104.0",
    "pdfjs-dist": "4.8.69",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-dropzone": "^14.4.1",
    "react-hook-form": "^7.89.0",
    "react-pdf": "^9.2.1",
    "react-resizable-panels": "^2.1.9",
    "server-only": "^0.0.1",
    "tailwind-merge": "^2.6.1",
    "zod": "^3.25.76",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@netlify/plugin-nextjs": "^5.16.2",
    "@playwright/test": "^1.64.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitest/coverage-v8": "^2.1.9",
    "autoprefixer": "^10.6.1",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "eslint-plugin-local": "file:eslint-rules",
    "gifenc": "^1.0.3",
    "jsdom": "^25.0.1",
    "msw": "^2.15.0",
    "netlify-cli": "^17.38.1",
    "pg": "^8.23.1",
    "pngjs": "^7.0.0",
    "postcss": "^8.5.29",
    "supabase": "^2.120.0",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=22"
  }
}
